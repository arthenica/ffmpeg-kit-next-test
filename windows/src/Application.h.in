#ifndef FFMPEG_KIT_TEST_APPLICATION_H
#define FFMPEG_KIT_TEST_APPLICATION_H

#include "AudioTab.h"
#include "CommandTab.h"
#include "ConcurrentExecutionTab.h"
#include "FFKitProtocolsTab.h"
#include "HttpsTab.h"
#include "OtherTab.h"
#include "SubtitleTab.h"
#include "Tab.h"
#include "VideoTab.h"
#include "VidStabTab.h"

#include <vector>
#include <windows.h>

namespace ffmpegkittest {

    /**
     * The main window: a tab control hosting one child window per test page.
     */
    class Application {
        public:
            Application();

            /** Creates and shows the main window. Returns false when creation fails. */
            bool create();

            /** Runs the message loop until the window is closed. Returns the exit code. */
            int run();

            static void listFFmpegSessions();
            static void listFFprobeSessions();

            // Both directories are returned with forward slashes so that every
            // caller can drop them straight into an FFmpeg command. See
            // Util::toCommandPath() for why that conversion is needed here.
            static std::string getApplicationCacheDirectory();
            static std::string getApplicationInstallDirectory();
            static std::string getCACertificateBundlePath();

            // The raw, unconverted install prefix as CMake configured it.
            static std::string getConfiguredInstallDirectory() {
                return "@CMAKE_INSTALL_PREFIX@";
            }

        private:
            static LRESULT CALLBACK windowProcedure(HWND window, UINT message, WPARAM wParam, LPARAM lParam);

            void onCreate();
            void onLayout();
            void onTabChanged();
            void paintHeader(HDC deviceContext);

            void initApplicationCacheDirectory();
            void registerApplicationFonts();

            HWND hwnd;
            HWND tabControl;

            AudioTab audioTab;
            CommandTab commandTab;
            ConcurrentExecutionTab concurrentExecutionTab;
            FFKitProtocolsTab ffkitProtocolsTab;
            HttpsTab httpsTab;
            OtherTab otherTab;
            SubtitleTab subtitleTab;
            VideoTab videoTab;
            VidStabTab vidStabTab;

            // Display order. There is deliberately no Pipe tab: named pipes are not
            // supported on Windows.
            std::vector<Tab*> tabs;
    };

}

#endif // FFMPEG_KIT_TEST_APPLICATION_H
